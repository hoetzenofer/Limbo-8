    <comp lib="9" loc="(1040,610)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Loads on clk ↑ when gc = 0"/>
    </comp>
    <comp lib="9" loc="(1320,220)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Source 13: flags"/>
    </comp>
    <comp lib="9" loc="(1320,250)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Bit 0 = C, bit 1 = Z, bit 7 = N"/>
    </comp>
    <comp lib="9" loc="(450,180)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Zero detect"/>
    </comp>
    <comp lib="9" loc="(450,210)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="nz = 0 when the bus is $00"/>
    </comp>
    <comp lib="9" loc="(720,190)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Control logic (4× NOR)"/>
    </comp>
    <comp lib="9" loc="(720,220)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="zc = NOT nz,   pop = NOT nload"/>
    </comp>
    <comp lib="9" loc="(720,250)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="gzn = NOR(FL_ZN, pop),   gc = NOR(FL_C, pop)"/>
    </comp>
    <comp lib="9" loc="(720,580)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Flag register Z, N"/>
    </comp>
    <comp lib="9" loc="(720,610)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Loads on clk ↑ when gzn = 0"/>
    </comp>
    <comp lib="9" loc="(720,890)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="CLR on GND – later to /RESET"/>
    </comp>
