    <comp lib="9" loc="(1080,1200)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="XOR"/>
    </comp>
    <comp lib="9" loc="(1080,1230)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="xo = A XOR T"/>
    </comp>
    <comp lib="9" loc="(1080,240)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Adder"/>
    </comp>
    <comp lib="9" loc="(1080,270)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="s = A + tx + cin   (carry c4: U4 → U5, c8 → c_out)"/>
    </comp>
    <comp lib="9" loc="(1080,560)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="AND"/>
    </comp>
    <comp lib="9" loc="(1080,590)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="an = A AND T"/>
    </comp>
    <comp lib="9" loc="(1080,880)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="OR"/>
    </comp>
    <comp lib="9" loc="(1080,910)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="or = A OR T"/>
    </comp>
    <comp lib="9" loc="(1640,1200)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Source 7: XOR"/>
    </comp>
    <comp lib="9" loc="(1640,1230)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Onto the bus when noe_xor = 0"/>
    </comp>
    <comp lib="9" loc="(1640,1520)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Source 8: SHR"/>
    </comp>
    <comp lib="9" loc="(1640,1550)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="A shifted right by one, bit 7 = 0"/>
    </comp>
    <comp lib="9" loc="(1640,240)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Source 4: ADD/SUB"/>
    </comp>
    <comp lib="9" loc="(1640,270)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Onto the bus when noe_add = 0"/>
    </comp>
    <comp lib="9" loc="(1640,560)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Source 5: AND"/>
    </comp>
    <comp lib="9" loc="(1640,590)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Onto the bus when noe_and = 0"/>
    </comp>
    <comp lib="9" loc="(1640,880)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Source 6: OR"/>
    </comp>
    <comp lib="9" loc="(1640,910)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Onto the bus when noe_or = 0"/>
    </comp>
    <comp lib="9" loc="(420,240)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Invert T"/>
    </comp>
    <comp lib="9" loc="(420,270)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="tx = T XOR ALU_INV (for SUB)"/>
    </comp>
    <comp lib="9" loc="(860,240)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Carry-in"/>
    </comp>
    <comp lib="9" loc="(860,270)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="cin = ci0 OR (ci1 AND C)"/>
    </comp>
    <comp lib="9" loc="(860,545)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="g1 = NOT ci0,  g2 = NAND(ci1, C)"/>
    </comp>
    <comp lib="9" loc="(860,570)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="cin = NAND(g1, g2)"/>
    </comp>
