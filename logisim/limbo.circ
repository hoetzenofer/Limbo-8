      <a name="halign" val="left"/>
      <a name="text" val="writes while /CE = 0 and /WE = 0 (RAM input WE active low)"/>
    </comp>
    <comp lib="9" loc="(1400,1120)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="data out only while /CE = 0, /OE = 0 and /WE = 1"/>
    </comp>
    <comp lib="9" loc="(1400,300)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="U2 (74138): VRAM and I/O"/>
    </comp>
    <comp lib="9" loc="(1400,330)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="G1 = a15, C B A = a14 a13 a12"/>
    </comp>
    <comp lib="9" loc="(1400,360)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="/Y6 = nvram_ce ($E000–$EFFF), /Y7 = nio ($F000–$FFFF)"/>
    </comp>
    <comp lib="9" loc="(1700,600)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="RAM 62256 (ram62256): $8000–$DFFF"/>
    </comp>
    <comp lib="9" loc="(1700,630)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="/CE = nrc, /OE = noe_mem, /WE = nwe"/>
    </comp>
    <comp lib="9" loc="(800,180)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Memory: ROM $0000–$7FFF, RAM $8000–$DFFF, select lines for VRAM and I/O"/>
    </comp>
    <comp lib="9" loc="(800,210)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="noe_mem = /MEM_RD (source 3), nmem_wr = /MEM_WR (destination 5). $E000–$FFFF: nobody drives bus_out"/>
    </comp>
    <comp lib="9" loc="(800,300)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="U1 (7400): RAM /CE and /WE"/>
    </comp>
    <comp lib="9" loc="(800,330)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="nrc = NAND(a15, NAND(a14, a13)): RAM at $8000–$DFFF"/>
    </comp>
    <comp lib="9" loc="(800,360)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="nwe = NAND(NOT nmem_wr, clk) = nmem_wr OR NOT clk: writes only while clk = 1"/>
    </comp>
    <comp lib="9" loc="(880,1160)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Model of the 28C256 pins (not built, inside the chip)"/>
    </comp>
    <comp lib="9" loc="(880,1190)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="data out only while /CE = 0 and /OE = 0"/>
    </comp>
    <comp lib="9" loc="(880,700)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="ROM 28C256 (rom28c256): $0000–$7FFF"/>
    </comp>
    <comp lib="9" loc="(880,730)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="/CE = a15, /OE = noe_mem; /WE on VCC (breadboard). Program: right click → Load Image"/>
    </comp>
