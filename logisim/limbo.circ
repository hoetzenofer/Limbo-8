      <a name="halign" val="left"/>
      <a name="text" val="U3 (74273): bits 16–23 from mc2"/>
    </comp>
    <comp lib="9" loc="(1240,330)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="ALU_INV, CIN, FL_ZN, FL_C, HLT; 22, 23 free"/>
    </comp>
    <comp lib="9" loc="(480,200)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Control word latch: takes the microcode word on clk ↓ and holds it for one clock"/>
    </comp>
    <comp lib="9" loc="(480,230)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="nreset = 0: all outputs 0 at once, so only nSTEP_RST is active (step counter stays on 0)"/>
    </comp>
    <comp lib="9" loc="(480,300)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="U1 (74273): bits 0–7 from mc0"/>
    </comp>
    <comp lib="9" loc="(480,330)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="DB_SRC = bits 0–3, DB_DST = bits 4–7"/>
    </comp>
    <comp lib="9" loc="(680,810)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="U4 (7404): nck = NOT clk, npl = NOT q11 (nPC_LD)"/>
    </comp>
    <comp lib="9" loc="(680,840)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="4 gates free, inputs on GND"/>
    </comp>
    <comp lib="9" loc="(860,300)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="U2 (74273): bits 8–15 from mc1"/>
    </comp>
    <comp lib="9" loc="(860,330)" name="Text">
