    <comp lib="9" loc="(1160,310)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="U3 (7400): counter clocks and load"/>
    </comp>
    <comp lib="9" loc="(1160,340)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="up = NAND(SP_INC, clk), dn = NAND(SP_DEC, clk)"/>
    </comp>
    <comp lib="9" loc="(1160,370)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="npl = NAND(NOT nld_sp, clk) = /SP_LD OR /CLK"/>
    </comp>
    <comp lib="9" loc="(480,160)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Stack pointer: 2× 74193, counts at clk ↓, loads while clk = 1"/>
    </comp>
    <comp lib="9" loc="(480,190)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="SP_INC / SP_DEC = 1: +1 / −1 at the end of the step.  nld_sp = 0 (destination 10): SP follows bus_in while clk = 1"/>
    </comp>
    <comp lib="9" loc="(480,220)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Stack page fixed: address = $DF00 + SP.  No reset: LDSP is the first instruction"/>
    </comp>
    <comp lib="9" loc="(480,370)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="U1 (74193): SP 0–3"/>
    </comp>
    <comp lib="9" loc="(480,860)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="U4 (74541): SP → addr_out 0–7"/>
