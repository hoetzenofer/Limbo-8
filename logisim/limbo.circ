    <comp lib="9" loc="(1220,260)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Microcode"/>
    </comp>
    <comp lib="9" loc="(180,180)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Control unit: IR, condition mux, step counter, microcode, control word latch, bus decoder"/>
    </comp>
    <comp lib="9" loc="(180,210)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="clk ↓: the latch takes the control word for (IR, step, cond).  clk ↑: the IR loads in the fetch step, the step counter counts or goes to 0 (STEP_RST)"/>
    </comp>
    <comp lib="9" loc="(180,260)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Inputs"/>
    </comp>
    <comp lib="9" loc="(1860,1260)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="nld_ir stays inside: it loads the IR in the fetch step"/>
    </comp>
    <comp lib="9" loc="(1860,1290)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="nSTEP_RST goes back to the step counter"/>
    </comp>
    <comp lib="9" loc="(1860,260)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Control word latch and bus decoder"/>
    </comp>
    <comp lib="9" loc="(1860,640)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="AB_SRC is decoded in addr_mux (74HC139), not here"/>
    </comp>
    <comp lib="9" loc="(2560,260)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Outputs"/>
    </comp>
    <comp lib="9" loc="(580,260)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="IR, condition, step"/>
    </comp>
