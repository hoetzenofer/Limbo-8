    <comp lib="9" loc="(480,200)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Program counter (PC): 4× 74161, counts and loads on clk ↑"/>
    </comp>
    <comp lib="9" loc="(480,230)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="PC_INC = 1: +1.  nPC_LD = 0: loads addr_in (address bus, from MAR or X), load wins over counting.  nreset = 0: $0000 at once"/>
    </comp>
    <comp lib="9" loc="(480,260)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Carry chain: ENP = PC_INC on all four, ENT of U1 on VCC, ENT of U2–U4 = RCO of the one below (counts only while all lower ones stand at F)"/>
    </comp>
    <comp lib="9" loc="(480,350)" name="Text">
